{
  "name": "@zaimokuza/dsh-plugin-hub-source-demo",
  "version": "0.1.1",
  "description": "Demo source plugin: adds the Zaimokuza tab to Plugin Hub",
  "license": "MIT",
  "author": {
    "name": "zaimokuza-yoshiteru"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaimokuza-yoshiteru/dsh-plugin-hub.git",
    "directory": "packages/source-demo"
  },
  "homepage": "https://github.com/zaimokuza-yoshiteru/dsh-plugin-hub",
  "bugs": {
    "url": "https://github.com/zaimokuza-yoshiteru/dsh-plugin-hub/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@zaimokuza/dsh-plugin-hub": "0.1.1",
    "@zaimokuza/dsh-plugin-hub-source-catalog-demo": "0.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node --check src/index.js"
  },
  "dshPluginHub": {
    "hostCompatibility": "capability-based",
    "testedDshVersions": [
      "0.1.2-rc.1"
    ]
  }
}
